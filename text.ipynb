#in a list of numbers, find all peaks. A peak is a number that is greater than the number to its left and the number to its right
#  Example Input: [1, 5, 2, 6, 3]
#  Example Output: Peaks: [5, 6]
nums = [1, 5, 2, 6, 3]
peaks=[]
for i in range(1, len(nums) -1):
    if nums[i] > nums[i-1] and nums[i] > nums[i+1]:
        peaks.append(nums[i])
print("Peaks:" , peaks)
# take a dict like{"A":1,"B":2,"C":1} and flip it. If two keys have the same value, the new value should be a list of those keys
# inpUt{"A":,1,"B":2,"C":1}
# output{1:["A",C],2["B"]}
data = {"A" : 1, "B": 2, "C": 1}
new_dict = {}
for key , value in data.items():
    if value not in new_dict:
        new_dict[value] = [key]
    else:
        new_dict[value].append(key)
print(new_dict)
