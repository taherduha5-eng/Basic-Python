#Ask the user for a number Sn$. Calculate the factorial (n!) using a loop, and then check if the resulting factorial is divisible by the sum of numbers from 1 to $n$.
#Example Input: 4
#Example Output: Factorial is 24, Sum is 10. 24 is not divisible by 10.
number=int(input("enter you num: "))
Factorial=1
sum_numbers=0
for i in range(1,number+1):
    Factorial*=i
    sum_numbers+=i
if Factorial % sum_numbers==0:
    print("Disvisible")
else:
    print("Not Disisible")


#Start with a dictionary of items and prices: ('apple': 0.5, 'bread': 2.0, 'milk': 1.5). Allow the user to
#"Add" or "Remove" items from a cart. If they add an item not in the store, print an error. Finally, print the total bill
# Example input:Add:apple,Add:milk
# Example output: Total Bill$2.0
store={"apple": 0.5 , "bread": 2.0 , "milk": 1.5}
cart=[]
while True:
    action = input("Add/Remove/Done")
    if action=='Done':
        break
    item = input("Item: ")
store = {'apple': 0.5, 'bread': 2.0, 'milk': 1.5}
cart = []

while True:
    action = input("Type 'Add', 'Remove' or 'Done': ").lower()
    if action == 'done':
        break
    
    item = input("Enter item name: ").lower()
    
    if action == 'add':
        if item in store:
            cart.append(item)
        else:
            print("Error: Item not in store!")
    elif action == 'remove':
        if item in cart:
            cart.remove(item)
        else:
            print("Error: Item not in cart!")
total = 0
for item in cart:
    total +=store[item]
print(f"Total Bill: ${total}")   
