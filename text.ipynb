#Ask a user to enter a password.check it is vaild based on these rules: lenth must be between 8and16 char
#And it must contain at least one uppercase letter and one specialchar(e.g,,@,#,$)
#input:Guest@123
#output:Password is secure
ps= input("Enter Ps: ") 
upper=True
special=True

for c in ps:
    if c.isupper():
        upper="True"
    if c =="@" or c =="#" or c =="_":
        special="True"
if len(ps)>=8 and len(ps)<=16 and upper and special:
    print("ps is secure")
else:
    print("ps is not secure")

