# Create a dictionary where the keys are the vowels found in a user's string and the values are lists of the indices where those vowels appear.
#  Example INPUT:banana
# output: {"a";[1,3,5]}
user_input = input("Enter a letter").strip()
vowels = "aeiouAEIOU"
vowel_empty = {}
for index, char in enumerate(user_input):
    if char in vowels:
        if char in vowel_empty:
            vowel_empty[char].append(index)
        else:
            vowel_empty[char]= [index]
print(vowel_empty)